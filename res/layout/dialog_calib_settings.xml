<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_calib_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_calib_dialog_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="НАСТРОЙКА АВТОКАЛИБРОВКИ"
                android:textColor="@color/volt_lime"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Адаптация под текущую музыку"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_calib_dialog_close_x"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="@drawable/bg_info_button"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border_subtle" />

    <!-- Duration Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ДЛИТЕЛЬНОСТЬ ЗАМЕРА"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.06"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_calib_dur_3s"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:background="@drawable/bg_pill_dark"
            android:text="3 сек"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_calib_dur_5s"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:background="@drawable/bg_pill_dark"
            android:text="5 сек"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_calib_dur_10s"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_pill_dark"
            android:text="10 сек"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border_subtle" />

    <!-- Parameter Toggles -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="КАЛИБРУЕМЫЕ ПАРАМЕТРЫ"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.06"
        android:textStyle="bold" />

    <!-- Toggle 1: Gains -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Чувствительность спектра и полос"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <com.antigravity.pulselight.ModernSwitch
            android:id="@+id/switch_calib_gains"
            android:layout_width="48dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <!-- Toggle 2: Thresholds -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Пороги срабатывания полос"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <com.antigravity.pulselight.ModernSwitch
            android:id="@+id/switch_calib_thresholds"
            android:layout_width="48dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <!-- Toggle 3: Sensitivity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Чувствительность удара"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <com.antigravity.pulselight.ModernSwitch
            android:id="@+id/switch_calib_sens"
            android:layout_width="48dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <!-- Toggle 4: Loudness RMS Gate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Гейт громкости RMS"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <com.antigravity.pulselight.ModernSwitch
            android:id="@+id/switch_calib_loudness"
            android:layout_width="48dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <!-- Toggle 5: Decay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Время затухания"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <com.antigravity.pulselight.ModernSwitch
            android:id="@+id/switch_calib_decay"
            android:layout_width="48dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@color/border_subtle" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_dialog_cancel_calib"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:background="@drawable/bg_pill_dark"
            android:text="Отмена"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_dialog_start_calib"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:gravity="center"
            android:background="@drawable/bg_pill_lime"
            android:text="Запустить замер"
            android:textColor="@color/text_black"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
